{
  "name": "youtube-mcp",
  "version": "1.2.2",
  "description": "YouTube MCP server and Claude Desktop extension: transcripts, search, stats, comments, playlists and trending.",
  "type": "module",
  "license": "MIT",
  "author": "Promethic Labs",
  "repository": { "type": "git", "url": "https://github.com/Promethic-Labs/youtube-mcp.git" },
  "keywords": ["mcp", "model-context-protocol", "claude", "youtube", "transcript", "mcpb"],
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/index.js",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/build.mjs && mcpb pack dist youtube-mcp.mcpb",
    "validate": "mcpb validate manifest.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "*",
    "esbuild": "^0.25.0"
  }
}
